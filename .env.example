# =====================================================================
#  Vercel: Project › Settings › Environment Variables (Production + Preview)
#  Lokal : salin ke .env.local
# =====================================================================

# --- Database (Neon) -------------------------------------------------
# Connection string POOLED untuk role aplikasi `cms_app` (BUKAN neondb_owner).
# Ambil connection string *pooled* di Neon Console › Connect, lalu ganti user
# `neondb_owner` dan password-nya dengan `cms_app` + password dari db/00_create_app_role.sql:
DATABASE_URL=postgresql://cms_app:PASSWORD_CMS_APP@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# --- Auth (Better Auth) -------------------------------------------------
# Rahasia acak min. 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publik website (tanpa garis miring di akhir). Di Vercel boleh dikosongkan:
# otomatis memakai domain produksi Vercel.
BETTER_AUTH_URL=https://www.mildigital.id

# --- Object Storage (Neon) ----------------------------------------------
# Neon Console › Branch › Object storage. Lihat README › "Object storage".
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-N.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=mil-media
# Opsional: base URL publik file (default: AWS_ENDPOINT_URL_S3/S3_BUCKET)
# S3_PUBLIC_BASE_URL=

# --- Opsional -------------------------------------------------------------
# Canonical URL untuk SEO (canonical, og:url, og:image absolut).
SITE_URL=https://www.mildigital.id

# --- Analytics (lihat docs/ANALYTICS.md) ----------------------------------
# Wajib: rahasia untuk cron retensi harian (openssl rand -hex 32)
CRON_SECRET=f7042bca648c3d9a60ed3693ff6da44f6dbf19516e98a922b082094fc81fbc46
# opt-in (default) | notice | none
ANALYTICS_CONSENT_MODE=opt-in
ANALYTICS_TZ=Asia/Jakarta
ANALYTICS_RETENTION_DAYS=395
# IP kantor/agency yang tidak dihitung, dipisah koma (IP tidak pernah disimpan)
ANALYTICS_EXCLUDE_IPS=
# ANALYTICS_ENABLED=false   # hentikan perekaman

# =====================================================================
#  HANYA LOKAL — jangan dimasukkan ke Vercel
# =====================================================================
# Connection string neondb_owner, dipakai `npm run admin:create` / `admin:password`
# (tabel admin_users hanya bisa ditulis owner, bukan oleh aplikasi).
DATABASE_URL_OWNER=postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
