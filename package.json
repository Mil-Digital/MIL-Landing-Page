{
  "name": "mil-digital-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:fidelity": "tsx scripts/fidelity-check.ts",
    "db:seed-sql": "tsx scripts/generate-seed.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "extract": "python3 scripts/extract_original.py",
    "admin:password": "tsx --env-file=.env.local scripts/create-admin.ts --reset",
    "storage:cors": "tsx --env-file=.env.local scripts/setup-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.20",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
